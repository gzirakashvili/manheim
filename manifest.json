{
  "manifest_version": 3,
  "name": "Z Parser",
  "description": "მანქანა ანახე და გადაიტანს ყველას და ყველაფერს.",
  "version": "1.7.3",
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "host_permissions": [
    "https://*.manheim.com/*","https://manheim.com/*","https://*.copart.com/*","https://*.iaai.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.copart.com/*"],
      "js": ["scripts/jquery.js","login.js","data_set_myauto.js","scripts/copart.js"]
    },
    {
      "matches": ["https://*.iaai.com/*"],
      "js": ["scripts/jquery.js","login.js","data_set_myauto.js","scripts/iaai.js"]
    },
    {
      "matches": ["https://*.cars.com/*"],
      "js": ["scripts/jquery.js","login.js","data_set_myauto.js","scripts/cars.js"]
    }
  ],
  "permissions": ["scripting"],
  "web_accessible_resources": [{ 
    "resources": ["data_set_myauto.json"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}